        "binCounts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "Calendar": {
      "type": "object",
      "additionalProperties": false,
      "description": "One histogram of a published calendar (format 1-4-0): the run's known values of a DATE or TIMESTAMP column counted by month, ISO day of week or hour of week in UTC, compared with the profile's levelHistogram/1 as a histogram is. The score is one minus the total variation distance. A histogram the profile withheld is censored and one the comparison refused is refused; neither has a score.",
      "required": [
        "propertyId",
        "property",
        "dimension",
        "outcome",
        "score",
        "weight",
        "column",
        "histogram",
        "records",
        "distance",
        "tolerance",
        "refusals"
      ],
      "properties": {
        "propertyId": {
          "type": "string",
          "minLength": 1,
          "description": "calendar:<column>.<histogram>"
        },
        "property": {
          "const": "calendar"
        },
        "dimension": {
          "const": "temporal"
        },
        "outcome": {
          "enum": [
            "within",
            "outside",
            "censored",
            "refused"
          ]
        },
        "score": {
          "$ref": "#/$defs/Score"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "histogram": {
          "enum": [
            "month",
            "dayOfWeek",
            "hourOfWeek"
          ]
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "description": "The run's count of known values of the column."
        },
        "distance": {
          "description": "The total variation distance between the two histograms, or null when none was formed.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Exact"
            }
          ]
        },
        "tolerance": {
          "description": "The largest distance the histogram may have, widened by the noise of a noisy profile histogram, or null when none was formed.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Exact"
            }
          ]
        },
        "widening": {
          "description": "The widening a noisy profile histogram gave the tolerance; present only when the histogram was scored and the profile's was noisy.",
          "$ref": "#/$defs/Exact"
        },
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Refusal"
          }
        }
      }
    },
