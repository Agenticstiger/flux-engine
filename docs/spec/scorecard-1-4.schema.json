            "calibration",
            "heldOut"
          ],
          "additionalProperties": false,
          "properties": {
            "calibration": {
              "$ref": "#/$defs/Share"
            },
            "heldOut": {
              "$ref": "#/$defs/Share"
            }
          }
        },
        "grades": {
          "type": "object",
          "description": "The privacy grade of the pinned profile and of the held-out profile (ADR 0020, rule 2), or null for one that was not read.",
          "required": [
            "pinned",
            "heldOut"
          ],
          "additionalProperties": false,
          "properties": {
            "pinned": {
              "enum": [
                "P0",
                "P1",
                "P3",
                "P4",
                null
              ]
            },
            "heldOut": {
              "enum": [
                "P0",
                "P1",
                "P3",
                "P4",
                null
              ]
            }
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueryRow"
          },
          "description": "One row per query of the registry, in its order."
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueryRequirement"
          },
          "description": "One row per requirement the queries put on the copy."
        }
      }
    },
    "QueryRequirement": {
      "type": "object",
      "description": "Format 1-4-0, the queries dimension (SCORECARD-SPEC.md section 3a, ADR 0028 section 7). What a query needs the copy to hold, as the consumers wrote it, and whether the run's rows hold it. It names no value of the data.",
      "required": [
        "query",
        "exposeId",
        "column",
        "kind",
        "description",
        "status",
        "met"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string"
        },
        "exposeId": {
          "type": "string"
        },
        "column": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "level",
            "value",
            "pattern",
            "nulls",
            "range"
          ]
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "met",
            "unmet",
            "versionsDiffer",
            "timedOut",
            "outOfMemory",
            "error",
            "crashed"
          ]
        },
        "met": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
