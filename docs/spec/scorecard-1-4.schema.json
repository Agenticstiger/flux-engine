        "satisfied": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "share": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Exact"
            }
          ]
        }
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propertyId",
        "property",
        "dimension",
        "outcome",
        "score",
        "weight",
        "fact",
        "run",
        "profile",
        "tolerance",
        "gap",
        "enforced"
      ],
      "properties": {
        "propertyId": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "const": "invariants"
        },
        "outcome": {
          "enum": [
            "within",
            "outside",
            "censored"
          ]
        },
        "score": {
          "$ref": "#/$defs/Score"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        },
        "property": {
          "const": "fact"
        },
        "fact": {
          "type": "string",
          "minLength": 1,
          "description": "<exposeId>.<ruleId>"
        },
        "run": {
          "$ref": "#/$defs/Holds"
        },
        "profile": {
          "description": "The share the profile measured, or null when it holds none.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Holds"
            }
          ]
        },
        "tolerance": {
          "$ref": "#/$defs/Exact"
        },
        "gap": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Exact"
            }
          ]
        },
        "enforced": {
          "type": "boolean"
        }
      }
    },
    "Relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propertyId",
        "property",
        "dimension",
        "outcome",
        "score",
        "weight",
        "relationship",
        "child",
        "parent",
        "fromColumns",
        "toColumns",
        "cardinality",
        "joinType",
        "checks"
      ],
      "properties": {
        "propertyId": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "const": "crossTable"
        },
        "outcome": {
          "enum": [
            "within",
            "outside",
            "censored"
          ]
        },
        "score": {
          "$ref": "#/$defs/Score"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        },
        "property": {
          "const": "referentialIntegrity"
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        },
        "child": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "minLength": 1
        },
        "fromColumns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "toColumns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cardinality": {
          "enum": [
            "many_to_one",
            "one_to_one"
          ]
        },
        "joinType": {
          "enum": [
            "left",
            "inner"
          ]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "found"
          ],
          "properties": {
            "found": {
              "$ref": "#/$defs/Holds"
            },
            "unique": {
              "$ref": "#/$defs/Holds"
            },
            "nulls": {
              "$ref": "#/$defs/Holds"
            },
            "oneToOne": {
              "$ref": "#/$defs/Holds"
            }
          }
        }
      }
    },
    "ChildrenPerParent": {
      "type": "object",
      "additionalProperties": false,
      "description": "Children per parent of one relationship (format 1-4-0): the run's parents counted into the profile's bins by their children, compared with the profile's marginalHistogram/1 of children per parent as a histogram is.",
      "required": [
        "propertyId",
        "property",
        "dimension",
        "outcome",
        "score",
        "weight",
        "relationship",
        "child",
        "parent",
        "bins",
        "run",
        "profile",
        "tolerance",
        "distance"
      ],
      "properties": {
        "propertyId": {
          "type": "string",
          "minLength": 1,
          "description": "children:<child exposeId>.<relationship>"
        },
        "dimension": {
          "const": "crossTable"
        },
        "outcome": {
          "enum": [
            "within",
            "outside",
            "censored"
          ]
        },
        "score": {
          "$ref": "#/$defs/Score"
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        },
        "property": {
          "const": "childrenPerParent"
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        },
        "child": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "minLength": 1
        },
        "bins": {
          "type": "array",
          "minItems": 2,
          "description": "The profile's bin edges, whole numbers of children; a bin is half open and the last is closed.",
          "items": {
            "$ref": "#/$defs/Exact"
          }
        },
        "run": {
          "$ref": "#/$defs/ParentsByBin"
        },
        "profile": {
          "description": "The profile's counts, or null when it withheld them.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ParentsByBin"
            }
          ]
        },
        "tolerance": {
          "$ref": "#/$defs/Exact"
        },
        "distance": {
          "description": "The total variation distance between the two histograms, or null when one is missing.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Exact"
            }
          ]
        }
      }
    },
    "ParentsByBin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parents",
        "binCounts"
      ],
      "description": "Parents counted into the bins by their number of children.",
      "properties": {
        "parents": {
          "type": "integer",
          "minimum": 0
