                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "alert"
          ],
          "additionalProperties": false,
          "properties": {
            "alert": {
              "enum": [
                "CONSTANT",
                "HIGH_CARDINALITY",
                "LOW_CARDINALITY"
              ]
            }
          }
        }
      ]
    },
    "Holds": {
      "type": "object",
