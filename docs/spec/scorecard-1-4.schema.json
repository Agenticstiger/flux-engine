            "cells": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "alert",
            "cell",
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "alert": {
              "const": "IMBALANCE"
            },
            "cell": {
