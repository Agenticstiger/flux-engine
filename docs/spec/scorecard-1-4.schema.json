      "description": "Format 1-4-0, the queries dimension (SCORECARD-SPEC.md section 3a, ADR 0028 section 7). What counting the consumers' queries on the run found, or why they were not counted. A scorecard that holds it names format 1-4-0.",
      "oneOf": [
        {
          "$ref": "#/$defs/QueriesCounted"
        },
        {
          "$ref": "#/$defs/QueriesNotCounted"
        }
      ]
    },
    "QueryRow": {
      "type": "object",
      "description": "Format 1-4-0, the queries dimension (SCORECARD-SPEC.md section 3a, ADR 0028 section 7). One consumer query as counted. rate is rows over unitRows, exact; gap is the rate less the target; met is true when the gap is within the tolerance, false when it is not, and null when the query has no target, no tolerance or no rate. A query with groupBy holds one group row per group, and its own target, gap and met are the groups' together.",
      "required": [
        "name",
        "set",
        "digest",
        "rows",
        "unitRows",
        "rate",
        "target",
        "gap",
        "tolerance",
        "status",
        "met",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "set": {
          "enum": [
            "calibration",
            "heldOut"
          ]
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "rows": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "unitRows": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "rate": {
          "$ref": "#/$defs/Score"
        },
        "target": {
          "$ref": "#/$defs/Score"
        },
        "gap": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Exact"
            }
          ]
        },
        "tolerance": {
          "$ref": "#/$defs/Score"
        },
        "status": {
          "enum": [
            "measured",
            "noRows",
            "notARate",
            "noTarget",
            "withheld",
            "timedOut",
            "outOfMemory",
            "error",
            "crashed",
            "versionsDiffer"
          ]
        },
        "met": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why a query that was not counted was not, as the query process named it. Never a value of the data."
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueryGroup"
          },
          "description": "Present for a query with groupBy: the null group first, then the levels by code point."
        }
      }
    },
    "QueriesNotCounted": {
      "type": "object",
      "description": "Format 1-4-0, the queries dimension (SCORECARD-SPEC.md section 3a, ADR 0028 section 7). The queries were not counted: the sql extra is not installed, or the run's artifacts do not reproduce its digest. The dimension is not measured, and a threshold declared on it is not met.",
      "required": [
        "status",
        "detail",
        "install"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not counted"
        },
        "detail": {
          "type": "string"
        },
        "install": {
          "type": "string",
          "description": "The command that installs the libraries the queries need."
        }
      }
    },
    "QueriesCounted": {
      "type": "object",
      "description": "Format 1-4-0, the queries dimension (SCORECARD-SPEC.md section 3a, ADR 0028 section 7). Every query counted on the run, the requirements, the two shares, the versions that counted and the grades of the two profiles.",
      "required": [
        "status",
        "versions",
        "shares",
        "grades",
        "queries",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "counted"
        },
        "versions": {
          "$ref": "#/$defs/QueriesVersions"
        },
        "shares": {
          "type": "object",
          "description": "The share of the calibration queries, and of the held-out queries, that have a target and a tolerance and fall within it. The dimension's score is the smaller of the shares that exist.",
