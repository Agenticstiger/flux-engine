{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticstiger.github.io/flux/engine/spec/parameter-register/1-2-0/FluxParameterRegister.json",
  "title": "FLUX parameter register, format 1-2-0",
  "description": "What each number a run reads rests on: a statistic of the profile its Simulation pins, a place in the FLUID contract the run emits from, an assumption with its reason, or a default, and the statistics of the pinned profile no number rests on, each with its reason. Format 1-2-0 adds the unused list to format 1-1-0, and a record names it only when the Simulation lists them. Written by apply as run/parameter-register.json when the Simulation declares a register, bound by the plan's parameterRegisterDigest. Counts are JSON integers, and every number of the bundle is written as the exact decimal text it was declared as. The shape is checked here; docs/spec/PARAMETER-REGISTER-SPEC.md states the rules the schema cannot express, among them that the counts add up to declared and that each parameter's source is its entry's.",
  "type": "object",
  "required": [
    "_producer",
    "_schemaURL",
    "simulationId",
    "profile",
    "declared",
    "counts",
    "entries",
    "parameters",
    "unused"
  ],
  "additionalProperties": false,
  "properties": {
    "_producer": {
      "type": "string",
      "format": "uri",
      "description": "The tool that wrote the record (OpenLineage BaseFacet)."
    },
    "_schemaURL": {
      "const": "https://agenticstiger.github.io/flux/engine/spec/parameter-register/1-2-0/FluxParameterRegister.json"
    },
    "simulationId": {
      "type": "string",
      "minLength": 1,
      "description": "The Simulation whose run the record describes."
    },
    "profile": {
      "description": "The profile the Simulation pins, or null when it pins none.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "digest"
          ],
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "The pinned profile's jcs-document digest."
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "declared": {
      "type": "integer",
      "minimum": 0,
      "description": "How many numbers the register counts: the length of parameters."
    },
    "counts": {
      "type": "object",
      "required": [
        "profile",
        "contract",
        "assumption",
        "default"
      ],
      "additionalProperties": false,
      "description": "How many numbers rest on each source. They add up to declared.",
      "properties": {
        "profile": {
          "type": "integer",
          "minimum": 0
        },
        "contract": {
          "type": "integer",
          "minimum": 0
        },
        "assumption": {
          "type": "integer",
          "minimum": 0
        },
        "default": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entries": {
      "type": "array",
      "description": "The register's entries as the Simulation declares them, in its order.",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "parameters": {
      "type": "array",
      "description": "Every number the register counts, documents in NFC order of their ids, each document in key order.",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "unused": {
      "description": "The statistics of the pinned profile no number of the run rests on, in the order the Simulation lists them.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/unused"
      }
    }
  },
  "$defs": {
    "pointer": {
      "type": "string",
      "pattern": "^(/([^~]|~[01])*)*$",
      "description": "An RFC 6901 JSON Pointer."
    },
    "source": {
      "enum": [
        "profile",
        "contract",
        "assumption",
        "default"
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "index",
        "document",
        "pointer",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "The entry's place in the declared list."
        },
        "document": {
          "type": "string",
          "minLength": 1,
          "description": "The id of the document the pointer is read in."
        },
        "pointer": {
          "$ref": "#/$defs/pointer",
          "description": "The numbers the entry names: one, or every number under a mapping or a list."
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "statistic": {
          "type": "object",
          "required": [
            "pointer"
          ],
          "additionalProperties": false,
          "description": "A profile source's citation: a pointer into the pinned profile and the registered definition it lands in (a table's rowCount has none).",
          "properties": {
            "pointer": {
              "$ref": "#/$defs/pointer"
            },
            "definition": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*/[1-9][0-9]*$"
            }
          }
        },
        "contract": {
          "type": "object",
          "required": [
            "productRef",
            "pointer"
          ],
          "additionalProperties": false,
          "description": "A contract source's citation: the id of a FLUID contract the run emits from (the productRef its emit names) and a pointer into that contract.",
          "properties": {
            "productRef": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "$ref": "#/$defs/pointer"
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Why an assumption holds, or a default's note: one line of text."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "profile"
              }
            }
          },
          "then": {
            "required": [
              "statistic"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reason"
                  ]
                },
                {
                  "required": [
                    "contract"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "contract"
              }
            }
          },
          "then": {
            "required": [
              "contract"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reason"
                  ]
                },
                {
                  "required": [
                    "statistic"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "assumption"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "statistic"
                  ]
                },
                {
                  "required": [
                    "contract"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "default"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "statistic"
                  ]
                },
                {
                  "required": [
                    "contract"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "required": [
        "document",
        "kind",
        "pointer",
        "value",
        "source",
        "entry"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "The FLUX kind of the document."
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "The number exactly as declared, as decimal text."
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "entry": {
          "description": "The index of the entry that decided the source, or null for a default no entry names.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "unused": {
      "type": "object",
      "required": [
        "statistic",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "statistic": {
          "type": "object",
          "required": [
            "pointer"
          ],
          "additionalProperties": false,
          "properties": {
            "pointer": {
              "$ref": "#/$defs/pointer"
            },
            "definition": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}
